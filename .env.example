# Copy to .env and replace both required secrets before using Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDMINE_SECRET_KEY_BASE=replace-with-output-of-openssl-rand-hex-64
COSMOSYS_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
# COSMOSYS_INITIAL_ADMIN_PASSWORD_FILE=/run/secrets/cosmosys_initial_admin_password

POSTGRES_DB=redmine
POSTGRES_USER=redmine
COSMOSYS_BIND_ADDRESS=127.0.0.1
COSMOSYS_HTTP_PORT=3000
COSMOSYS_SESSION_COOKIE_KEY=_cosmosys_session
REDMINE_LANG=en

# Reproducible source revisions. Change deliberately and validate together.
COSMOSYS_REVISION=a678d44ae6bb71df9d4ac3e8274fcfd90fdbd005
COSMOSYS_REQ_REVISION=da016a4210cdedc2d671fa7390f50e3928a2a42b
RSPREADSHEET_REVISION=3cf3031fc122306d09af7e503b66338c1b8ceb09
REDMINE_IMAGE=redmine:7.0.0@sha256:966156b9feff91511fb022b3fb5c1059c303e1c26f40baa670257c5fde0de2c7
POSTGRES_IMAGE=postgres:16-alpine@sha256:20edbde7749f822887a1a022ad526fde0a47d6b2be9a8364433605cf65099416
