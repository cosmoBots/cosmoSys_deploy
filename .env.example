# Copy to .env and replace both required secrets before using Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDMINE_SECRET_KEY_BASE=replace-with-output-of-openssl-rand-hex-64
COSMOSYS_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
# COSMOSYS_INITIAL_ADMIN_PASSWORD_FILE=/run/secrets/cosmosys_initial_admin_password

POSTGRES_DB=redmine
POSTGRES_USER=redmine
COSMOSYS_BIND_ADDRESS=127.0.0.1
COSMOSYS_HTTP_PORT=3000
COSMOSYS_SESSION_COOKIE_KEY=_cosmosys_session
REDMINE_LANG=en
# Deployment variant: base, or requirements to add cosmoSys Requirements.
# The scripts add compose.requirements.yml when this file says so.
# COSMOSYS_VARIANT=base

# EXPERIMENTAL: Kroki works; this opt-in deployment wiring is provisional
# until Iván integrates it into a more modular deployment strategy.
# Optional Redmine-Kroki and cosmoSys Kroki integration plugins plus private
# Kroki service stack. Set to true to add both plugins and start the Kroki gateway
# plus its Mermaid, BPMN, Excalidraw and diagrams.net companions.
COSMOSYS_KROKI_ENABLED=false
# Redmine-Kroki 0.5.0: immutable SHA of the repository's main HEAD.
REDMINE_KROKI_REVISION=489602ae50b5949a24004e072670a12a379730cf
# cosmoSys Kroki integration 0.1.0: immutable plugin source revision.
COSMOSYS_KROKI_REVISION=7a981637ba165cfcf331a826c5c8bc34d775d6ef
COSMOSYS_KROKI_IMAGE=cosmobots/cosmosys-kroki:965eaf7-489602a-7a98163-redmine-7.0.1
COSMOSYS_REQ_KROKI_IMAGE=cosmobots/cosmosys-req-kroki:965eaf7-6df0fce-489602a-7a98163-redmine-7.0.1
# EXPERIMENTAL: LaTeX works; this opt-in deployment wiring is provisional
# until Iván integrates it into a more modular deployment strategy. Currently
# available only with Requirements + Kroki.
COSMOSYS_LATEX_ENABLED=false
COSMOSYS_LATEX_REVISION=9ae5de392a0795c1a4a5dca8afc1604f3412a6c8
COSMOSYS_REQ_KROKI_LATEX_IMAGE=cosmobots/cosmosys-req-kroki-latex:965eaf7-6df0fce-489602a-7a98163-9ae5de3-redmine-7.0.1
# EXPERIMENTAL: Notebook Preview depends on redmine_cbots_latex. Current
# deployment wiring is only available on the Requirements + Kroki + LaTeX stack.
COSMOSYS_NOTEBOOK_PREVIEW_ENABLED=false
REDMINE_NOTEBOOK_PREVIEW_REVISION=91aa27e8fa371944e092179a9a0127810091dc8a
COSMOSYS_REQ_KROKI_LATEX_NOTEBOOK_PREVIEW_IMAGE=cosmobots/cosmosys-req-kroki-latex-notebook-preview:965eaf7-6df0fce-489602a-7a98163-9ae5de3-91aa27e-redmine-7.0.1
# EXPERIMENTAL: PORIS is currently deployable only on the full validation stack
# above. This is a deployment-wiring constraint, not a plugin dependency.
COSMOSYS_PORIS_ENABLED=false
COSMOSYS_PORIS_REVISION=1e953cf6608de394a3f92a835c145f74bc807f45
COSMOSYS_REQ_KROKI_LATEX_NOTEBOOK_PREVIEW_PORIS_IMAGE=cosmobots/cosmosys-req-kroki-latex-notebook-preview-poris:965eaf7-6df0fce-489602a-7a98163-9ae5de3-91aa27e-1e953cf-redmine-7.0.1
KROKI_SERVER_IMAGE=yuzutech/kroki:0.32.1@sha256:6980bfb218b48b74ea14b888d9c7e8c032d1cb6325f3292277abdf62483abd9d
KROKI_MERMAID_IMAGE=yuzutech/kroki-mermaid:0.32.1@sha256:ad6721646aabfb8b5f5005db2daa6e37189c25e18aab19a8ef8590b6171cd192
KROKI_BPMN_IMAGE=yuzutech/kroki-bpmn:0.32.1@sha256:1558692f39cbede20f70f732d34c906dde7a3333e004f55dc66ea8fbfc3e7d70
KROKI_EXCALIDRAW_IMAGE=yuzutech/kroki-excalidraw:0.32.1@sha256:214f13c1cd3c3f79a18a83631a900fedbed71b2f39d3a0c5630ac5fa5ad40046
KROKI_DIAGRAMSNET_IMAGE=yuzutech/kroki-diagramsnet:0.32.1@sha256:71e7082f736ec003fb33b5cd1c5c40af54c9bfb6351d50fbe73b56fe8f1bd5eb

