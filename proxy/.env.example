# Copy to proxy/.env to change the defaults.

# External network that published instances join.
COSMOSYS_PROXY_NETWORK=caddy_proxy

# Where the proxy listens on this host.
COSMOSYS_PROXY_BIND_ADDRESS=0.0.0.0
COSMOSYS_PROXY_HTTP_PORT=80
COSMOSYS_PROXY_HTTPS_PORT=443

# Default certificate mode for provisioned instances: the e-mail address of the
# Let's Encrypt account, or internal for certificates from Caddy's own authority.
COSMOSYS_PROXY_TLS=
