# Copy to shared-db/.env and replace the administrator password.
COSMOSYS_DB_ADMIN_PASSWORD=replace-with-a-long-random-password
COSMOSYS_DB_ADMIN_USER=postgres

# Instances reach the server through this external network and host name.
COSMOSYS_DB_NETWORK=csys_db
COSMOSYS_DB_HOST=csys-db

COSMOSYS_DB_MAX_CONNECTIONS=100
# Connection limit given to each provisioned instance role.
COSMOSYS_DB_CONNECTION_LIMIT=20

# Keep equal to the instance POSTGRES_IMAGE; scripts/check-config.sh checks it.
POSTGRES_IMAGE=postgres:16-alpine@sha256:20edbde7749f822887a1a022ad526fde0a47d6b2be9a8364433605cf65099416
